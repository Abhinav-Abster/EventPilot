# EventPilot Environment Configuration

# Google Gemini API Key (required for AI features)
# Add this value to .env.local in development, then restart EventPilot.
GEMINI_API_KEY=

# Model selection (Optional, defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Application Configuration
NEXT_PUBLIC_APP_NAME=EventPilot
