# EventPilot Environment Configuration

# Google Gemini API Key (Optional)
# If omitted, EventPilot automatically runs in a fully-featured, deterministic Demo Mode.
GEMINI_API_KEY=

# Model selection (Optional, defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Application Configuration
NEXT_PUBLIC_APP_NAME=EventPilot
